# Image generation (sprite scripts only — never shipped to the browser).
OPENAI_API_KEY=sk-...

# ElevenLabs text-to-speech (read server-side by the /api/tts dev proxy; never bundled).
# Without these the app falls back to the built-in Web Speech voice.
ELEVENLABS_API_KEY=sk-...
# Optional overrides:
# ELEVENLABS_VOICE_ID=pFZP5JQG7iQjIQuC4Bku   # default: "Lily" (soft, warm British storyteller)
# ELEVENLABS_MODEL_ID=eleven_flash_v2_5      # default: low-latency model with timestamps

# Production only (the deployed api/ functions): daily budgets and classroom codes. All optional.
# CLASSROOM_CODES=ISTEK-7K2M, PS12-4QZ   # codes handed to teachers by email; comma/space separated
# PARTNER_DAILY_USD_PUBLIC=0.30          # Claude spend per UTC day for anonymous visitors
# PARTNER_DAILY_USD_CLASSROOM=0.40       # Claude spend per UTC day per classroom code
# TTS_DAILY_CHARS_PUBLIC=30000           # ElevenLabs characters per day for anonymous visitors
# TTS_DAILY_CHARS_CLASSROOM=100000       # ElevenLabs characters per day per classroom code
# ANTHROPIC_USD_PER_MTOK_IN=2            # list prices used to bill each call (Sonnet 5)
# ANTHROPIC_USD_PER_MTOK_OUT=10
# KV_REST_API_URL= / KV_REST_API_TOKEN=  # set by the Vercel Marketplace (Upstash Redis) for exact counters
